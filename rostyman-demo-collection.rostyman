      "items": [
        {
          "type": "request",
          "name": "Bearer Token",
          "description": "Test Bearer token auth — httpbin echoes the Authorization header back",
          "method": "GET",
          "url": "{{httpbinUrl}}/bearer",
          "params": [],
          "headers": [],
          "auth": {
            "type": "bearer",
