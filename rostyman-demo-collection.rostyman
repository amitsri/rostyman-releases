          "params": [],
          "headers": [],
          "auth": {
            "type": "digest",
            "digest": {
              "username": "user",
              "password": "pass"
            }
          },
          "body": {
            "mode": "none"
          },
          "preScript": "",
          "testScript": "rm.test('Auth successful', () => {\n  rm.expect(rm.response.code).to.equal(200);\n});\n\nrm.test('Authenticated', () => {\n  const data = rm.response.json();\n  rm.expect(data.authenticated).to.be.true;\n});"
        },
